# Copy to .env and fill in. Every variable is described at
# https://justmytwospence.github.io/shipshape/reference/environment/

# --- Where your compose files are -----------------------------------------------------

# The checkout of the git repository that holds your compose files, as an absolute path.
REPO_DIR=/srv/compose

# Where that repository is published. On GitHub, owner/repo is enough:
GITHUB_REPO=you/compose
# A fine-grained token for that one repository with Contents: read and write. shipshape
# pushes what it ships with it, and reads release notes on GitHub under its rate limit.
GITHUB_TOKEN=

# On Gitea, Forgejo or GitLab instead, give the https URL and a token for that host.
# GIT_REMOTE_URL wins over GITHUB_REPO; GITHUB_TOKEN then only raises GitHub's rate limit.
# GIT_REMOTE_URL=https://git.example.com/you/compose.git
# GIT_USERNAME=you
# GIT_TOKEN=

# The branch shipshape ships to. Default: the branch origin/HEAD names in REPO_DIR, else main.
# GIT_BRANCH=main

# --- Signing in -----------------------------------------------------------------------

# The password for the web interface: 12 characters or more. Wrap it in single quotes
# if it contains $, # or a space.
SHIPSHAPE_PASSWORD=
# Or read it from a file (a Docker secret): SHIPSHAPE_PASSWORD_FILE=/run/secrets/shipshape_password
# The https address you open shipshape at, if it sits behind TLS. Makes the session cookie
# Secure, and is needed (with SHIPSHAPE_ACTION_SECRET, 32+ characters) for the action links
# in email and ntfy messages.
# SHIPSHAPE_ALLOWED_ORIGIN=https://shipshape.example.com
# SHIPSHAPE_ACTION_SECRET=

# --- Permissions ----------------------------------------------------------------------

# The user and group that own the checkout: stat -c '%u %g' /srv/compose
PUID=1000
PGID=1000
# The group that owns the docker socket: stat -c %g /var/run/docker.sock
DOCKER_GID=

# --- Optional -------------------------------------------------------------------------

# Changelog reviews by Claude. Without a key, updates still ship, on the evidence that is
# left; see https://justmytwospence.github.io/shipshape/concepts/review/ for other models.
ANTHROPIC_API_KEY=
# Other model providers (see the same page): OpenRouter, or any Anthropic-Messages endpoint
# such as Ollama or LiteLLM, which wins over the keys above.
# OPENROUTER_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=

# Your time zone, for dates and the scan schedule.
TZ=UTC

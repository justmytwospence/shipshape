# Copy to .env and fill in. Every variable is described at
# https://justmytwospence.github.io/shipshape/reference/environment/

# The checkout of your compose repository (absolute path), and where it is published.
REPO_DIR=/srv/compose
GITHUB_REPO=you/compose
# A fine-grained token for that repository with Contents: read and write.
GITHUB_TOKEN=

# The branch shipshape ships to. Default: the branch origin/HEAD names in REPO_DIR, else main.
# GIT_BRANCH=main

# The host name Traefik serves shipshape at, without https://.
SHIPSHAPE_HOST=shipshape.example.com
# The Authelia user(s) allowed in, comma-separated.
SHIPSHAPE_ALLOWED_USER=you

# The owner of the checkout (stat -c '%u %g' /srv/compose) and the docker socket's group
# (stat -c %g /var/run/docker.sock).
PUID=1000
PGID=1000
DOCKER_GID=

# Optional: changelog reviews, and your time zone.
ANTHROPIC_API_KEY=
# Other model providers (see the same page): OpenRouter, or any Anthropic-Messages endpoint
# such as Ollama or LiteLLM, which wins over the keys above.
# OPENROUTER_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=
TZ=UTC

{
  "name": "shipshape",
  "version": "0.2.0",
  "private": true,
  "description": "Docker Compose image updates for a homelab kept in git: reads the changelog, ships what nothing holds back, deploys, verifies and rolls back.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run css && tsc -p tsconfig.build.json && cp src/prompts/*.md dist/prompts/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./test/setup.ts --test 'test/**/*.test.ts' 'test/web/*.test.tsx'",
    "resolve-report": "tsx src/bin/resolve-report.ts",
    "convert-v1": "tsx src/bin/convert-v1.ts",
    "demo:seed": "tsx src/bin/seed-demo.ts",
    "db:baseline": "tsx src/db/baseline.ts",
    "jev-replay": "tsx src/bin/jev-replay.ts",
    "dev:ui": "node bin/dev-ui.mjs",
    "shots": "node bin/shots.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "css": "tailwindcss -i src/styles/app.css -o public/app.css --minify",
    "css:watch": "tailwindcss -i src/styles/app.css -o public/app.css --watch",
    "pretest": "npm run css && node bin/check-test-prereqs.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "changelog": "git-cliff --output CHANGELOG.md",
    "preversion": "npm run typecheck && npm test",
    "version": "git-cliff --tag \"v$npm_package_version\" --output CHANGELOG.md && git add CHANGELOG.md",
    "release": "npm version --message 'chore(release): v%s'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^13.2.0",
    "croner": "^9.1.0",
    "execa": "^9.6.0",
    "hono": "^4.13.20",
    "nodemailer": "^10.6.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/cli": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "daisyui": "^5.8.1",
    "git-cliff": "^2.14.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "homepage": "https://justmytwospence.github.io/shipshape/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justmytwospence/shipshape.git"
  },
  "bugs": {
    "url": "https://github.com/justmytwospence/shipshape/issues"
  }
}

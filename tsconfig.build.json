{
  // The shipped build: sources only, emitted to dist/. tsconfig.json is the checking
  // config (src and test, no emit) that `npm run typecheck` and editors use.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
